{
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFiles": [
        "(^|/)([^/]+/)?Dockerfile$"
      ],
      "groupName": "Docker base image updates",
      "labels": [
        "dependencies",
        "docker"
      ],
      "automerge": false
    },
    {
      "description": "opennms-horizon exists to stay on UBI 9 (no x86-64-v3); only follow ubi9 jre-21 base tags.",
      "matchPackageNames": [
        "docker.io/opennms/deploy-base",
        "opennms/deploy-base"
      ],
      "allowedVersions": "/^ubi9-.*-jre-21$/"
    }
  ]
}
