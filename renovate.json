{
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "dockerfile","github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFiles": [
        "(^|/)([^/]+/)?Dockerfile$"
      ],
      "groupName": "Docker base image updates",
      "labels": [
        "dependencies",
        "docker"
      ],
      "automerge": false
    }
  ]
}
